# Copy to .env and adjust as needed.

# --- Backend ---
DATABASE_URL=postgresql+asyncpg://dockiq:dockiq@postgres:5432/dockiq
NATS_URL=nats://nats:4222
# Address the backend hands to agents at enrollment (must be reachable by the agent).
# For remote hosts, set this to the control plane's advertised NATS address.
NATS_ADVERTISE_URL=nats://nats:4222

# --- Diagnostic Query Agent (Engine 11) ---
# Required to enable natural-language diagnostics. Without it the feature is off.
ANTHROPIC_API_KEY=
DIAGNOSTIC_MODEL=claude-opus-5

# --- Auth / RBAC (Phase 7) ---
AUTH_ENABLED=true
# CHANGE THESE for any non-local deployment.
JWT_SECRET=dev-insecure-change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
# If set, agents must present this token to enroll (leave empty for open dev enrollment).
AGENT_JOIN_TOKEN=

# --- Agent (local test via `--profile agent`) ---
HOST_NAME=local-docker-host
